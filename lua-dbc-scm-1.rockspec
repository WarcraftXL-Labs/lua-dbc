package = "lua-dbc"
version = "scm-1"
source = {
   url = "git+https://github.com/WarcraftXL-Labs/lua-dbc.git",
   branch = "dev",
}
description = {
   summary = "Fluent LuaJIT DBC editor and LINQ query engine for WoW WotLK 3.3.5a",
   detailed = [[
      lua-dbc provides FFI-based reading, editing, and querying of World of Warcraft 3.3.5a DBC files with PascalCase reflection, LINQ query capabilities, cross-table relations, and full LuaLS autocomplete support.
   ]],
   homepage = "https://github.com/WarcraftXL-Labs/lua-dbc",
   license = "GPL-3.0",
}
dependencies = {
   "lua >= 5.1",
}
build = {
   type = "builtin",
   modules = {
      ["dbc"] = "src/dbc/init.lua",
      ["dbc.file"] = "src/dbc/file.lua",
      ["dbc.proxy"] = "src/dbc/proxy.lua",
      ["dbc.table"] = "src/dbc/table.lua",
            ["dbc.query"] = "src/dbc/query.lua",
      ["dbc.session"] = "src/dbc/session.lua",
      ["dbc.workspace"] = "src/dbc/workspace.lua",
      ["dbc.relations"] = "src/dbc/relations.lua",
      ["dbc.schema"] = "src/dbc/schema.lua",
